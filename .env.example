PORT=8787
DATA_DIR=./data
# Free tier request cap per API key per calendar month
FREE_TIER_MONTHLY_LIMIT=100

# Optional for the free plan. Required for paid plans: create-key --plan
# starter/pro/scale fails clearly without STRIPE_SECRET_KEY, and the webhook
# route (src/routes/stripeWebhook.ts) responds 500 without
# STRIPE_WEBHOOK_SECRET. Usage reporting to Stripe silently no-ops for keys
# with no Stripe subscription attached (i.e. free-plan keys), regardless of
# whether these are set. See "Billing" in README.md for how to get these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL this instance is reachable at — used to build links in
# confirmation/reset emails. Defaults to localhost, which is fine for local
# dev but MUST be set to the real deployed URL in production or those links
# are useless. See README "Deployment" — this bit a real deploy once.
PUBLIC_BASE_URL=

# Optional. Without RESEND_API_KEY, emails just log to stdout + the
# outbox_emails table instead of actually sending (see README "Self-serve
# accounts"). EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=PDF Toolkit API <noreply@yourdomain.com>

# GET /admin/stats (see AdminDash/ADMIN_STATS_CONTRACT.md) fails closed with
# 503 if this is unset, rather than silently accepting an empty header.
# Generate a real random value: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=
